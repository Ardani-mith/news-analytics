# Database is created automatically. Use an absolute path for a custom location.
IDX_NEWS_DB=data/idx_news.db

# Public IDX JSON endpoint used by `collect`; override if IDX changes its route.
IDX_ANNOUNCEMENT_API=https://www.idx.co.id/primary/ListedCompany/GetAnnouncement
# `playwright` performs the same-origin API request inside Chromium after opening
# the IDX disclosure page. `httpx` is a lightweight direct-HTTP alternative.
IDX_TRANSPORT=playwright
IDX_REQUEST_DELAY_SECONDS=1.0

# Cost controls: rules score every new article; only high-materiality articles
# can reach DeepSeek, and no more than this many are scored each UTC day.
DEEPSEEK_MIN_MATERIALITY=60
DEEPSEEK_DAILY_LIMIT=50

# Streamlit refreshes its database view at this interval. It does not call IDX
# or DeepSeek. Use `cli monitor` separately to collect and score new records.
DASHBOARD_REFRESH_SECONDS=60
MONITOR_INTERVAL_MINUTES=15

# Optional: enables `score --provider deepseek`. Keep the real value only in
# your untracked .env file, never in source control.
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
